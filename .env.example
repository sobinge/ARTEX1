# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
ARTEX_BIND_ADDR=127.0.0.1
ARTEX_PORT=8787
ARTEX_PROXY_PORT=8788
# 可选全局出网代理，例如 host.docker.internal:7897（需允许容器连接）
ARTEX_PROXY_HOST=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Tor 首次启动默认值（已保存的 UI 配置优先）
ARTEX_TOR_POOL_ENABLED=true
ARTEX_TOR_POOL_SIZE=5
# 网络无法直接连接 Tor 时填写 HTTP CONNECT 上游，例如 host.docker.internal:7897。
# 该代理只承载 Tor 守护进程；应用的目标流量仍从 Tor 节点退出。
ARTEX_TOR_POOL_UPSTREAM=
# 可选独立网桥配置（私有配置文件不会打入镜像或提交 Git）
ARTEX_TOR_BRIDGES_CONFIG=./deploy/tor-bridges.conf
# 启用指定流量的 Clash 出口；自动备用仍需单独配置目标规则。
ARTEX_CLASH_ENABLED=0
# 可选：首次没有订阅节点时，用实际 HTTP/SOCKS 上游初始化一个节点。
# 例如 http://host.docker.internal:7897；保存的订阅节点优先，不会被此值覆盖。
ARTEX_CLASH_UPSTREAM=
