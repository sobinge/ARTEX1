# 运行镜像叠加 tor 可执行文件 + DNS 垫片。
#
# 为什么需要：
#   - ARTEX 的目标流量默认经 Tor 出口（tools.egress_class=target-probe 时 fail-closed），
#     而 runtime 阶段未预装 tor；
#   - tor 的 DNSPort 只支持 A/AAAA/PTR，这里让 slot1 额外在 127.0.0.1:53 提供 DNS，
#     容器 /etc/resolv.conf 指向它，避免域名解析泄漏到本地解析器。
#
# 先构建源码镜像，再构建本文件：
#   docker build -t artex-src:local -f Dockerfile .
#   docker build -t artex-tor:local -f Dockerfile.tor .
# 或直接执行 ./rebuild-local.sh。
ARG BASE=artex-src:local
FROM ${BASE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends tor iptables \
 && rm -rf /var/lib/apt/lists/*
COPY deploy/tor-shim.sh /usr/sbin/tor-shim.sh
RUN chmod 755 /usr/sbin/tor-shim.sh \
 && mv /usr/sbin/tor /usr/sbin/tor.real \
 && ln -s /usr/sbin/tor-shim.sh /usr/sbin/tor \
 && tor --version | head -1
# 容器入口：把容器内所有 DNS 重定向到 Tor DNSPort（见 deploy/artex-entry.sh）
COPY deploy/artex-entry.sh /usr/local/bin/artex-entry.sh
RUN chmod 755 /usr/local/bin/artex-entry.sh
ENTRYPOINT ["/usr/local/bin/artex-entry.sh"]
