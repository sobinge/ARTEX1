# 运行镜像叠加 tor + 全流量透明代理 + Clash(mihomo) 临时出口。
#
# 为什么需要：
#   - ARTEX 的目标流量默认经 Tor 出口（tools.egress_class=target-probe 时 fail-closed），
#     而 runtime 阶段未预装 tor；
#   - 光靠代理环境变量覆盖不到 nmap/dig 这类工具，因此在容器 netns 里做透明代理：
#     TCP -> tor TransPort(9040)，DNS(53) -> tor DNSPort(19053)，其余 UDP/ICMP 丢弃；
#     模型等平台自身出网通过 ARTEX_DIRECT_IPS 白名单直连（见 deploy/artex-entry.sh）；
#   - Tor 出口有时被目标/网络拦截，测试需要临时换出口：内置 mihomo（Clash.Meta），
#     以独立用户 clash 运行并在 iptables 中按 uid 豁免，避免上游被 Tor 劫持。
ARG BASE=artex-src:local
FROM ${BASE}
ARG MIHOMO_VERSION=v1.19.33
RUN apt-get update \
 && apt-get install -y --no-install-recommends tor iptables curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -r -u 910 -M -s /usr/sbin/nologin artestor \
 && useradd -r -u 912 -M -s /usr/sbin/nologin clash \
 && curl -fsSL -o /tmp/mihomo.gz \
      "https://github.com/MetaCubeX/mihomo/releases/download/${MIHOMO_VERSION}/mihomo-linux-amd64-${MIHOMO_VERSION}.gz" \
 && gunzip -c /tmp/mihomo.gz > /usr/local/bin/mihomo \
 && chmod 755 /usr/local/bin/mihomo && rm -f /tmp/mihomo.gz \
 && /usr/local/bin/mihomo -v
COPY deploy/tor-shim.sh /usr/sbin/tor-shim.sh
RUN chmod 755 /usr/sbin/tor-shim.sh \
 && mv /usr/sbin/tor /usr/sbin/tor.real \
 && ln -s /usr/sbin/tor-shim.sh /usr/sbin/tor \
 && tor --version | head -1
COPY deploy/clash-config.base.yaml /etc/mihomo/base.yaml
COPY deploy/clash-restart.sh /usr/local/bin/artex-clash-restart.sh
COPY deploy/artex-entry.sh /usr/local/bin/artex-entry.sh
RUN chmod 755 /usr/local/bin/artex-clash-restart.sh /usr/local/bin/artex-entry.sh
ENTRYPOINT ["/usr/local/bin/artex-entry.sh"]
